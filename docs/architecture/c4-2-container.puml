@startuml C4_Container_Step03
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram — Ledger Admin (step 03: use cases + MCP)

Person(operator, "Back-office operator", "Manages customers, accounts and transactions")
System_Ext(ai, "AI assistant", "Claude Code or Claude Desktop (MCP client)")

System_Boundary(ledger, "Ledger Admin") {
    Container(web, "Web Admin", "React 19 SPA served by Nginx", "Admin panel: dashboard, customers, accounts, transactions")
    Container(api, "Backend API", "NestJS 11 application (Node.js 22)", "REST under /api and an MCP server at /mcp; both are thin adapters over the same CQRS use cases")
    ContainerDb(db, "Database", "PostgreSQL 16", "Customers, accounts and transactions")
}

Rel(operator, web, "Uses", "HTTPS (browser)")
Rel(operator, ai, "Asks in plain language")
Rel(web, api, "Calls REST API (Nginx proxies /api)", "JSON/HTTP")
Rel(ai, api, "Calls 21 MCP tools", "MCP over Streamable HTTP")
Rel(api, db, "Reads and writes", "SQL over TypeORM")

@enduml
